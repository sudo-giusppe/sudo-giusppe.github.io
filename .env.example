# El admin genera este archivo en el primer arranque. No lo subas a git.
#
# Solo se guarda el hash scrypt de la clave, nunca la clave.
# Para generar o rotar la clave:
#     npm run admin
#     npm run admin:password -- --reset
ADMIN_PASSWORD_HASH=

# Opcionales
# ADMIN_PORT=4321
# ADMIN_SITE_URL=http://localhost:3000
#
# Por defecto el editor escucha solo en 127.0.0.1. Si lo pones detrás de un
# proxy HTTPS puedes usar ADMIN_PUBLIC_URL=https://admin.ejemplo.com
# ADMIN_PUBLIC_URL=

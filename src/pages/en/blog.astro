---
import Layout from "../../layouts/Layout.astro";
import AntField from "../../components/AntField.astro";
import SmoothTabs from "../../components/SmoothTabs.astro";
import { categoriesFor, countFor, getPosts } from "../../data/posts";

const posts = await getPosts("en");
const tabs = categoriesFor(posts, "en").map((category) => ({
	...category,
	count: countFor(posts, category.value),
}));
---

<Layout
	title="Archive"
	description="Archive of notes on math, computing systems and code."
	locale="en"
	alt={{ href: "/blog" }}
>
	<header class="page-head" data-reveal>
		<p class="kicker">archive</p>
		<h1 class="page-title">Archive</h1>
		<p class="lede">
			All notes, newest first. The list can be filtered by topic.
		</p>
	</header>

	<div data-reveal>
		<SmoothTabs items={tabs} total={posts.length} locale="en" />
	</div>

	<ul class="archive" id="archive-list">
		{
			posts.map((post) => (
				<li data-post data-category={post.category}>
					<a class="archive-row" href={post.href}>
						<time class="archive-date" datetime={post.date}>
							{post.date}
						</time>
						<span class="archive-title">{post.title}</span>
						<span class="archive-cat">{post.category}</span>
						<span class="archive-arrow" aria-hidden="true">
							→
						</span>
					</a>
				</li>
			))
		}
	</ul>

	<p class="forum-note">
		Questions about automata or evolutionary algorithms? The
		<a href="/en/forum">discussion room</a> is still open.
	</p>

	<AntField variant="mirror" />
</Layout>

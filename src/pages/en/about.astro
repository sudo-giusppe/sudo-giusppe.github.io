---
import Layout from "../../layouts/Layout.astro";
import AntField from "../../components/AntField.astro";
---

<Layout
	title="About"
	description="José Pedro Barraza — LICC, PUC de Chile, IBM Z ambassador."
	locale="en"
	alt={{ href: "/about" }}
>
	<section class="about-page">
		<header class="about-hero" data-reveal>
			<p class="kicker">about</p>
			<h1 class="about-name">José Pedro<br />Barraza</h1>
			<p class="about-intro">
				I study at the LICC, PUC of Chile.<br />
				I'm an IBM Z ambassador.
			</p>
		</header>

		<footer class="about-foot" data-reveal>
			<p class="about-place">Santiago, Chile</p>
			<nav class="about-links" aria-label="Personal links">
				<a href="/en/blog">notes <span aria-hidden="true">→</span></a>
				<a href="/en/forum">discussion <span aria-hidden="true">→</span></a>
			</nav>
		</footer>

		<AntField variant="turmite" />
	</section>
</Layout>

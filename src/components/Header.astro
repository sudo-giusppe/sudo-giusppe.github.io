---
import ThemeToggle from "./ThemeToggle.astro";
import { t, type Locale } from "../i18n/ui";

interface Props {
	locale?: Locale;
	/** URL of this page in the other language; hides the toggle if missing. */
	altHref?: string | null;
}

const { locale = "es", altHref = null } = Astro.props;

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

const prefix = locale === "en" ? "/en" : "";
const links = [
	{ href: prefix || "/", label: t(locale, "nav.home") },
	{ href: `${prefix}/blog`, label: t(locale, "nav.archive") },
	{ href: `${prefix}/about`, label: t(locale, "nav.about") },
	{ href: `${prefix}/forum`, label: t(locale, "nav.forum") },
];

const isRoot = (href: string) => href === "/" || href === "/en";
const isActive = (href: string) =>
	isRoot(href)
		? path === href
		: path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
	<div class="wrap header-inner">
		<a class="brand" href={prefix || "/"} aria-label={t(locale, "brand.aria")}>
			<span class="brand-name">
				<span class="brand-mark" aria-hidden="true"></span>
				JPBM
			</span>
			<span class="brand-sub">{t(locale, "brand.sub")}</span>
		</a>

		<nav class="nav" aria-label={t(locale, "nav.aria")}>
			{
				links.map((link) => (
					<a
						href={link.href}
						class:list={["nav-link", isActive(link.href) && "is-active"]}
						aria-current={isActive(link.href) ? "page" : undefined}
					>
						{link.label}
					</a>
				))
			}
			{
				altHref && (
					<a
						class="nav-link lang-toggle"
						href={altHref}
						aria-label={t(locale, "lang.toggle.aria")}
						title={t(locale, "lang.toggle.aria")}
					>
						{locale === "es" ? "EN" : "ES"}
					</a>
				)
			}
			<ThemeToggle locale={locale} />
		</nav>
	</div>
</header>

---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { t, type Locale } from "../i18n/ui";
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
	locale?: Locale;
	/** URL of this page in the other language, when it exists. */
	alt?: { href: string } | null;
}

const { title, locale = "es", alt = null, description = t(locale, "site.description") } =
	Astro.props;

const fullTitle =
	title === t(locale, "home.title")
		? t(locale, "site.fullTitle")
		: `${title} · JPBM`;

const otherLang = locale === "es" ? "en" : "es";
/** Spanish URL of this page, used as hreflang default. */
const defaultHref =
	locale === "es"
		? Astro.url.pathname
		: Astro.url.pathname.replace(/^\/en(?=\/|$)/, "") || "/";

const canonical = Astro.site
	? new URL(Astro.url.pathname, Astro.site).href
	: null;
const altUrl =
	alt && Astro.site ? new URL(alt.href, Astro.site).href : null;
const defaultUrl = Astro.site ? new URL(defaultHref, Astro.site).href : null;
---

<!doctype html>
<html lang={locale} class="no-js">
	<head>
		<meta charset="UTF-8" />
		<script is:inline>
			(() => {
				const root = document.documentElement;
				root.classList.remove("no-js");
				root.classList.add("js");
				let saved = null;
				try {
					saved = localStorage.getItem("theme");
				} catch {
					/* almacenamiento no disponible */
				}
				const dark = saved
					? saved === "dark"
					: window.matchMedia("(prefers-color-scheme: dark)").matches;
				root.dataset.theme = dark ? "dark" : "light";
			})();
		</script>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={locale === "es" ? "es_CL" : "en_US"} />
		<meta name="twitter:card" content="summary" />
		<meta
			name="theme-color"
			content="#f5f2ea"
			media="(prefers-color-scheme: light)"
		/>
		<meta
			name="theme-color"
			content="#121310"
			media="(prefers-color-scheme: dark)"
		/>
		<link
			rel="preload"
			href="/fonts/source-serif-4-latin-normal.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/ibm-plex-mono-400.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		{canonical && <link rel="canonical" href={canonical} />}
		{altUrl && <link rel="alternate" hreflang={otherLang} href={altUrl} />}
		{
			defaultUrl && locale === "es" && (
				<link rel="alternate" hreflang="es" href={defaultUrl} />
			)
		}
		{defaultUrl && <link rel="alternate" hreflang="x-default" href={defaultUrl} />}
		<title>{fullTitle}</title>
	</head>
	<body>
		<a class="skip-link" href="#main">{t(locale, "skip.content")}</a>
		<div class="progress" aria-hidden="true">
			<span class="progress__bar"></span>
		</div>
		<Header locale={locale} altHref={alt?.href ?? null} />
		<main id="main" class="site-main">
			<div class="wrap">
				<slot />
			</div>
		</main>
		<Footer locale={locale} />

		<script>
			import { animate, scroll, stagger } from "motion";

			const reduce = window.matchMedia(
				"(prefers-reduced-motion: reduce)",
			).matches;

			const bar = document.querySelector<HTMLElement>(".progress__bar");
			if (bar) {
				scroll(animate(bar, { scaleX: [0, 1] }, { ease: "linear" }));
			}

			const reveal = [...document.querySelectorAll<HTMLElement>("[data-reveal]")];
			if (!reduce && reveal.length > 0) {
				animate(
					reveal,
					{ opacity: [0.72, 1], y: [8, 0] },
					{
						duration: 0.6,
						delay: stagger(0.06),
						ease: [0.22, 1, 0.36, 1],
					},
				);
			}
		</script>
	</body>
</html>
